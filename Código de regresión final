import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from google.colab import files
import io

print("Por favor, sube tu archivo (CSV o Excel) usando el botón de abajo:")
uploaded = files.upload()

# Verificar que se haya subido un archivo
if len(uploaded) == 0:
    print("No se subió ningún archivo.")
else:
    # Obtener el nombre del primer archivo subido
    nombre_archivo = list(uploaded.keys())[0]
    print(f"\nArchivo cargado exitosamente: {nombre_archivo}")

    # Cargar el archivo según su extensión
    try:
        if nombre_archivo.endswith('.csv'):
            df = pd.read_csv(io.BytesIO(uploaded[nombre_archivo]))
        elif nombre_archivo.endswith(('.xlsx', '.xls')):
            df = pd.read_excel(io.BytesIO(uploaded[nombre_archivo]))
        else:
            raise ValueError("Formato no soportado. Sube un archivo CSV o Excel.")

        # Mostrar columnas disponibles
        print("\nEstas son las columnas detectadas en tu archivo:")
        for col in df.columns:
            print(f" - {col}")

        print("\nEscribe exactamente el nombre de las columnas (respeta mayúsculas y espacios).")
        col_x = input("Columna INDEPENDIENTE (X, ej. PIB): ")
        col_y = input("Columna DEPENDIENTE (Y, ej. Mortalidad): ")

        # Validar y procesar
        if col_x not in df.columns or col_y not in df.columns:
            print("\nError: Alguna de las columnas no existe en el archivo. Revisa la ortografía.")
        else:
            # Limpiar datos vacíos (NaN)
            df = df.dropna(subset=[col_x, col_y])

            # Preparar variables
            X = df[[col_x]]
            y = df[col_y]

            # Entrenar modelo
            modelo = LinearRegression()
            modelo.fit(X, y)
            predicciones = modelo.predict(X)

            # Graficar
            plt.figure(figsize=(10, 6))
            plt.scatter(X, y, color='blue', alpha=0.6, label='Datos reales')
            plt.plot(X, predicciones, color='red', linewidth=2, label='Línea de Regresión')

            plt.title(f'Regresión Lineal: {col_x} vs {col_y}', fontsize=14)
            plt.xlabel(col_x, fontsize=12)
            plt.ylabel(col_y, fontsize=12)
            plt.legend()
            plt.grid(True, linestyle='--', alpha=0.5)

            plt.show()

            # Mostrar métricas
            print("\n--- Resultados del Modelo ---")
            print(f"Intersección (b): {modelo.intercept_:.4f}")
            print(f"Pendiente (m): {modelo.coef_[0]:.4f}")

    except Exception as e:
        print(f"\nOcurrió un error al procesar el archivo: {e}")
